config_version=5
[application]
config/version="1.01"
config/use_custom_user_dir=true
config/custom_user_dir_name="PaintedStar"
config/name="彩绘星灵"
run/main_scene="res://full_game/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
[gui]
theme/custom_font="res://球面基础/fonts/game_body.tres"
[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/aspect.windows="keep"
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false
